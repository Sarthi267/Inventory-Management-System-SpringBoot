<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_DIR" value = "/Users/sarthipatel/Documents"/>
    <property name="FILE_PREFIX" value = "inventorymgmt"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy:MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [user:%X{username}] [req:%X{method} %X{uri}] - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/${FILE_PREFIX}.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
    <fileNamePattern>${LOG_DIR}/archived/${FILE_PREFIX}-%d{yyy-MM-dd}.log.gz</fileNamePattern>
    <maxHistory>30</maxHistory>
    </rollingPolicy>
    <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [user:%X{username}] [req:%X{method} %X{uri}] - %msg%n</pattern>
    </encoder>
    </appender>

    <logger name="com.github.sarthi267.inventorymanagementsystem" level="DEBUG"/>

<root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
</root>
</configuration>